<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#7fffffff"/>
                    <size
                        android:height="@dimen/dimen_16dp_sw_320_dp"
                        android:width="@dimen/dimen_16dp_sw_320_dp"/>
                </shape>
            </item>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="#ffffff"/>
                    <size
                        android:height="@dimen/dimen_12dp_sw_320_dp"
                        android:width="@dimen/dimen_12dp_sw_320_dp"/>
                </shape>
            </item>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="#b0b0bd"/>
                    <size
                        android:height="@dimen/dimen_6dp_sw_320_dp"
                        android:width="@dimen/dimen_6dp_sw_320_dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:height="@dimen/dimen_16dp_sw_320_dp"
                android:width="@dimen/dimen_16dp_sw_320_dp">
                <bitmap
                    android:src="@drawable/ic_transparent"
                    android:tileMode="repeat"/>
            </item>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="#ffffff"/>
                    <size
                        android:height="@dimen/dimen_12dp_sw_320_dp"
                        android:width="@dimen/dimen_12dp_sw_320_dp"/>
                </shape>
            </item>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="#b0b0bd"/>
                    <size
                        android:height="@dimen/dimen_6dp_sw_320_dp"
                        android:width="@dimen/dimen_6dp_sw_320_dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
