<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item
                android:id="@android:id/background"
                android:drawable="@drawable/ic_bg_seek_bar_v2_focused"/>
            <item android:id="@android:id/secondaryProgress">
                <scale
                    android:drawable="@drawable/ic_bg_progress_second_pb_v2"
                    android:scaleWidth="100%"/>
            </item>
            <item android:id="@android:id/progress">
                <scale
                    android:drawable="@drawable/ic_bg_progress_v2"
                    android:scaleWidth="100%"/>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:id="@android:id/background"
                android:drawable="@drawable/ic_bg_seek_bar_v2"/>
            <item android:id="@android:id/secondaryProgress">
                <scale
                    android:drawable="@drawable/ic_bg_progress_second_pb_v2"
                    android:scaleWidth="100%"/>
            </item>
            <item android:id="@android:id/progress">
                <scale
                    android:drawable="@drawable/ic_bg_progress_v2"
                    android:scaleWidth="100%"/>
            </item>
        </layer-list>
    </item>
</selector>
