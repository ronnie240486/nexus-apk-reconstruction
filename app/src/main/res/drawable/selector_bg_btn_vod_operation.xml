<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#7fffffff"/>
            <size
                android:height="@dimen/dimen_8dp_sw_320_dp"
                android:width="@dimen/dimen_12dp_sw_320_dp"/>
            <corners android:radius="@dimen/dimen_2dp_sw_320_dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#0096ff"/>
            <size
                android:height="@dimen/dimen_8dp_sw_320_dp"
                android:width="@dimen/dimen_12dp_sw_320_dp"/>
            <corners android:radius="@dimen/dimen_2dp_sw_320_dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#ffffff"/>
            <size
                android:height="@dimen/dimen_8dp_sw_320_dp"
                android:width="@dimen/dimen_12dp_sw_320_dp"/>
            <corners android:radius="@dimen/dimen_2dp_sw_320_dp"/>
        </shape>
    </item>
</selector>
