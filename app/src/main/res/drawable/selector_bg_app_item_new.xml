<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <stroke
                android:width="@dimen/dimen_2dp_sw_320_dp"
                android:color="@color/theme_highlight"/>
            <padding
                android:left="@dimen/dimen_3dp_sw_320_dp"
                android:top="@dimen/dimen_3dp_sw_320_dp"
                android:right="@dimen/dimen_3dp_sw_320_dp"
                android:bottom="@dimen/dimen_3dp_sw_320_dp"/>
            <corners android:radius="@dimen/dimen_4dp_sw_320_dp"/>
            <solid android:color="#b3cccccc"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <stroke
                android:width="@dimen/dimen_2dp_sw_320_dp"
                android:color="@color/theme_highlight"/>
            <padding
                android:left="@dimen/dimen_3dp_sw_320_dp"
                android:top="@dimen/dimen_3dp_sw_320_dp"
                android:right="@dimen/dimen_3dp_sw_320_dp"
                android:bottom="@dimen/dimen_3dp_sw_320_dp"/>
            <corners android:radius="@dimen/dimen_4dp_sw_320_dp"/>
            <solid android:color="#1acccccc"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <stroke
                android:width="@dimen/dimen_2dp_sw_320_dp"
                android:color="@color/theme_highlight"/>
            <padding
                android:left="@dimen/dimen_3dp_sw_320_dp"
                android:top="@dimen/dimen_3dp_sw_320_dp"
                android:right="@dimen/dimen_3dp_sw_320_dp"
                android:bottom="@dimen/dimen_3dp_sw_320_dp"/>
            <corners android:radius="@dimen/dimen_4dp_sw_320_dp"/>
            <solid android:color="#1acccccc"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/dimen_4dp_sw_320_dp"/>
            <solid android:color="#1affffff"/>
        </shape>
    </item>
</selector>
