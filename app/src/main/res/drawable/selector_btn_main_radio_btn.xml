<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/dimen_18dp_sw_320_dp"/>
            <gradient
                android:startColor="@color/theme_highlight"
                android:endColor="@color/theme_highlight"
                android:angle="0"
                android:type="linear"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/dimen_18dp_sw_320_dp"/>
            <gradient
                android:startColor="@color/theme_highlight"
                android:endColor="@color/theme_highlight"
                android:angle="0"
                android:type="linear"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/dimen_18dp_sw_320_dp"/>
        </shape>
    </item>
</selector>
