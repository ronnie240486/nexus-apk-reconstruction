<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <stroke
                android:width="1dp"
                android:color="#dcdcdc"/>
            <solid android:color="#c0c0c0"/>
            <corners android:radius="24dp"/>
            <size
                android:height="24dp"
                android:width="44dp"/>
            <padding
                android:left="12dp"
                android:right="12dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <stroke
                android:width="1dp"
                android:color="#dcdcdc"/>
            <solid android:color="#ffffff"/>
            <corners android:radius="24dp"/>
            <size
                android:height="24dp"
                android:width="44dp"/>
            <padding
                android:left="12dp"
                android:right="12dp"/>
        </shape>
    </item>
</selector>
