<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#f5e5af"/>
            <corners android:radius="@dimen/dimen_5dp_sw_320_dp"/>
            <stroke
                android:width="2px"
                android:color="#d9bd7a"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#f5e5af"/>
            <corners android:radius="@dimen/dimen_5dp_sw_320_dp"/>
            <stroke
                android:width="2px"
                android:color="#d9bd7a"/>
        </shape>
    </item>
    <item android:state_checked="true">
        <shape>
            <solid android:color="#f5e5af"/>
            <corners android:radius="@dimen/dimen_5dp_sw_320_dp"/>
            <stroke
                android:width="2px"
                android:color="#d9bd7a"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#d9bd7a"/>
            <stroke
                android:width="2px"
                android:color="#7d5518"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
</selector>
