<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@android:color/transparent"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <padding
                        android:left="@dimen/dimen_2dp_sw_320_dp"
                        android:top="@dimen/dimen_2dp_sw_320_dp"
                        android:right="@dimen/dimen_2dp_sw_320_dp"
                        android:bottom="@dimen/dimen_2dp_sw_320_dp"/>
                    <stroke
                        android:width="@dimen/dimen_1dp_sw_320_dp"
                        android:color="#ffffff"
                        android:dashWidth="@dimen/dimen_2dp_sw_320_dp"
                        android:dashGap="@dimen/dimen_2dp_sw_320_dp"/>
                    <corners android:radius="@dimen/dimen_12dp_sw_320_dp"/>
                    <solid android:color="@android:color/transparent"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
