<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#059ce5"/>
            <padding
                android:left="@dimen/dimen_2dp_sw_320_dp"
                android:top="@dimen/dimen_2dp_sw_320_dp"
                android:right="@dimen/dimen_2dp_sw_320_dp"
                android:bottom="@dimen/dimen_2dp_sw_320_dp"/>
            <corners android:radius="@dimen/dimen_4dp_sw_320_dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#059ce5"/>
            <padding
                android:left="@dimen/dimen_1dp_sw_320_dp"
                android:top="@dimen/dimen_1dp_sw_320_dp"
                android:right="@dimen/dimen_1dp_sw_320_dp"
                android:bottom="@dimen/dimen_1dp_sw_320_dp"/>
            <corners android:radius="@dimen/dimen_4dp_sw_320_dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#7f94c1"/>
            <padding
                android:left="@dimen/dimen_1dp_sw_320_dp"
                android:top="@dimen/dimen_1dp_sw_320_dp"
                android:right="@dimen/dimen_1dp_sw_320_dp"
                android:bottom="@dimen/dimen_1dp_sw_320_dp"/>
            <corners android:radius="@dimen/dimen_4dp_sw_320_dp"/>
        </shape>
    </item>
</selector>
