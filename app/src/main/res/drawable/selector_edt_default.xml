<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="@dimen/dimen_2dp_sw_320_dp"/>
            <stroke
                android:width="@dimen/dimen_1dp_sw_320_dp"
                android:color="@color/theme_highlight"/>
            <padding
                android:left="@dimen/dimen_6dp_sw_320_dp"
                android:top="@dimen/dimen_4dp_sw_320_dp"
                android:right="@dimen/dimen_6dp_sw_320_dp"
                android:bottom="@dimen/dimen_4dp_sw_320_dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="@dimen/dimen_5dp_sw_320_dp"/>
            <stroke
                android:width="@dimen/dimen_1dp_sw_320_dp"
                android:color="#444d88"/>
            <padding
                android:left="@dimen/dimen_6dp_sw_320_dp"
                android:top="@dimen/dimen_4dp_sw_320_dp"
                android:right="@dimen/dimen_6dp_sw_320_dp"
                android:bottom="@dimen/dimen_4dp_sw_320_dp"/>
        </shape>
    </item>
</selector>
