<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_title_bar_common"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_user_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_30dp_sw_320_dp"
        android:layout_below="@+id/rl_main_title_bar_common"
        android:layout_marginStart="@dimen/dimen_32dp_sw_320_dp"
        android:layout_marginEnd="@dimen/dimen_32dp_sw_320_dp">
        <TextView
            android:id="@+id/iv_click"
            android:text="@string/user_accountName"
            android:layout_centerVertical="true"
            style="@style/style_register_text"/>
        <EditText
            android:id="@+id/edt_user_name"
            android:hint="@string/user_accountNameHint"
            android:maxLength="18"
            android:inputType="text"
            android:layout_toEndOf="@+id/iv_click"
            android:importantForAutofill="no"
            style="@style/style_register_edit"/>
    </RelativeLayout>
    <View
        android:id="@+id/view_horizontal_line_1"
        android:layout_below="@+id/rl_user_phone"
        style="@style/style_horizontal_line"/>
    <RelativeLayout
        android:id="@+id/rl_get_v_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_horizontal_line_1"
        android:layout_marginStart="@dimen/dimen_32dp_sw_320_dp"
        android:layout_marginEnd="@dimen/dimen_32dp_sw_320_dp">
        <TextView
            android:id="@+id/tv_verification_code"
            android:text="@string/verification_code"
            android:layout_centerVertical="true"
            style="@style/style_register_text"/>
        <Button
            android:textSize="@dimen/dimen_12sp_sw_320_dp"
            android:id="@+id/btn_get_code"
            android:text="@string/get_verify_code"
            android:layout_alignParentEnd="true"
            style="@style/style_send_verify_code_btn"/>
        <EditText
            android:id="@+id/edt_verify_code"
            android:hint="@string/hint_input_verify_code"
            android:maxLength="40"
            android:inputType="textEmailAddress"
            android:layout_toStartOf="@+id/btn_get_code"
            android:layout_toEndOf="@+id/tv_verification_code"
            android:importantForAutofill="no"
            style="@style/style_register_edit"/>
    </RelativeLayout>
    <View
        android:id="@+id/view_horizontal_line_2"
        android:layout_below="@+id/rl_get_v_code"
        style="@style/style_horizontal_line"/>
    <RelativeLayout
        android:id="@+id/rl_user_pwd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_horizontal_line_2"
        android:layout_marginStart="@dimen/dimen_32dp_sw_320_dp"
        android:layout_marginEnd="@dimen/dimen_32dp_sw_320_dp">
        <TextView
            android:id="@+id/tv_pwd"
            android:text="@string/user_accountPassword"
            android:layout_centerVertical="true"
            style="@style/style_register_text"/>
        <EditText
            android:id="@+id/edt_pwd"
            android:hint="@string/user_accountPasswordHint"
            android:maxLength="18"
            android:inputType="textPassword"
            android:layout_toEndOf="@+id/tv_pwd"
            android:importantForAutofill="no"
            style="@style/style_register_edit"/>
    </RelativeLayout>
    <View
        android:id="@+id/view_horizontal_line_3"
        android:layout_below="@+id/rl_user_pwd"
        style="@style/style_horizontal_line"/>
    <RelativeLayout
        android:id="@+id/rl_user_pwd_again"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_horizontal_line_3"
        android:layout_marginStart="@dimen/dimen_32dp_sw_320_dp"
        android:layout_marginEnd="@dimen/dimen_32dp_sw_320_dp">
        <TextView
            android:id="@+id/tv_pwd_again"
            android:text="@string/user_confirm_password"
            android:layout_centerVertical="true"
            style="@style/style_register_text"/>
        <EditText
            android:id="@+id/edt_pwd_again"
            android:hint="@string/user_confirm_password_hint"
            android:maxLength="18"
            android:inputType="textPassword"
            android:layout_toEndOf="@+id/tv_pwd_again"
            android:importantForAutofill="no"
            style="@style/style_register_edit"/>
    </RelativeLayout>
    <View
        android:id="@+id/view_horizontal_line_4"
        android:layout_below="@+id/rl_user_pwd_again"
        style="@style/style_horizontal_line"/>
    <Button
        android:id="@+id/btn_submit"
        android:text="@string/confirm_dialog_ok"
        android:layout_below="@+id/view_horizontal_line_4"
        style="@style/style_login_btn"/>
</RelativeLayout>
