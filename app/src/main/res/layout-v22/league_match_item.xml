<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_league_match_item"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimen_40dp_sw_320_dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="#56668dff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/dimen_10dp_sw_320_dp"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/tv_date_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lines="2"
                android:singleLine="false"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/ll_match_menu_item_team_a"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">
            <ImageView
                android:id="@+id/iv_match_main_menu_team_a"
                android:background="#0000"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="20dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="@dimen/dimen_8dp_sw_320_dp"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/tv_match_main_menu_team_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="Team A"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/iv_match_main_menu_team_a"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_match_menu_item_match_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3">
            <TextView
                android:textSize="@dimen/dimen_12dp_sw_320_dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/tv_match_result_point"
                android:background="#0000"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:textAlignment="center"/>
            <TextView
                android:textSize="@dimen/dimen_6dp_sw_320_dp"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/tv_match_main_menu_complete"
                android:background="@drawable/drawable_bg_black_half_transparent"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingHorizontal="5dp"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/ll_match_menu_item_team_b"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">
            <ImageView
                android:id="@+id/iv_match_main_menu_team_b"
                android:background="#0000"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="20dp"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/dimen_8dp_sw_320_dp"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/tv_match_main_menu_team_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="Team B"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/iv_match_main_menu_team_b"/>
        </RelativeLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_match_main_menu_sub"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_match_main_item_sub"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
