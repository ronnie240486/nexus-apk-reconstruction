<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/itvLoadingDialog_padding"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/loading_img"
        android:layout_width="@dimen/itvLoadingDialog_img_width"
        android:layout_height="@dimen/itvLoadingDialog_img_height"
        android:src="@drawable/player_progress_img"/>
    <TextView
        android:textSize="@dimen/itvLoadingDialog_fontSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/loading_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_2dp_sw_320_dp"
        android:text="@string/loading_tv"/>
</LinearLayout>
