<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/drawable_bg_vod_error_dialog"
    android:paddingBottom="@dimen/dimen_10dp_sw_320_dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_14sp_sw_320_dp"
        android:textColor="#ffffff"
        android:id="@+id/tv_title_vod_error_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_26dp_sw_320_dp"
        android:text="@string/traffic_jam"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_28dp_sw_320_dp"
        android:layout_marginBottom="@dimen/dimen_8dp_sw_320_dp"
        android:layout_below="@+id/tv_title_vod_error_dialog"
        android:layout_centerHorizontal="true">
        <Button
            android:textSize="@dimen/dimen_14sp_sw_320_dp"
            android:textColor="@color/white"
            android:id="@+id/vod_error_dialog_btn"
            android:background="@drawable/vod_error_dialog_btn"
            android:paddingTop="@dimen/dimen_4dp_sw_320_dp"
            android:paddingBottom="@dimen/dimen_4dp_sw_320_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dimen_80dp_sw_320_dp"
            android:text="@string/try_again"
            android:maxLines="1"
            android:singleLine="true"/>
        <Button
            android:textSize="@dimen/dimen_14sp_sw_320_dp"
            android:textColor="@color/white"
            android:id="@+id/btn_next_set_layout_vod_error_dialog"
            android:background="@drawable/vod_error_dialog_btn"
            android:paddingTop="@dimen/dimen_4dp_sw_320_dp"
            android:paddingBottom="@dimen/dimen_4dp_sw_320_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_12dp_sw_320_dp"
            android:minWidth="@dimen/dimen_80dp_sw_320_dp"
            android:text="@string/next_set"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_toRightOf="@+id/vod_error_dialog_btn"/>
    </RelativeLayout>
</RelativeLayout>
