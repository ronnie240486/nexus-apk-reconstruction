<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:padding="@dimen/dimen_10dp_sw_320_dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_5dp_sw_320_dp">
        <TextView
            android:textColor="@color/grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/purchase_name"
            style="@style/style_user_text"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/style_user_text"/>
        <TextView
            android:textColor="@color/grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp_sw_320_dp"
            android:text="@string/purchase_amount"
            style="@style/style_user_text"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp_sw_320_dp"
            style="@style/style_user_text"/>
        <TextView
            android:textColor="@color/grey"
            android:id="@+id/tv_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp_sw_320_dp"
            android:text="@string/purchase_pay_type"
            style="@style/style_user_text"/>
        <TextView
            android:id="@+id/tv_pay_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp_sw_320_dp"
            android:layout_toRightOf="@+id/tv_type"
            style="@style/style_user_text"/>
        <TextView
            android:textColor="@color/grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp_sw_320_dp"
            android:text="@string/purchase_pay_time"
            android:layout_below="@+id/tv_type"
            style="@style/style_user_text"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp_sw_320_dp"
            android:layout_below="@+id/tv_type"
            style="@style/style_user_text"/>
        <TextView
            android:textColor="@color/grey"
            android:id="@+id/tv_pctype"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp_sw_320_dp"
            android:text="@string/purchase_type"
            style="@style/style_user_text"/>
        <TextView
            android:id="@+id/tv_pc_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp_sw_320_dp"
            android:layout_toRightOf="@+id/tv_pctype"
            style="@style/style_user_text"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_purchase"
        android:background="#f8f8f8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_40dp_sw_320_dp"
        android:layout_marginTop="10dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/tv_pc_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_15dp_sw_320_dp"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="9sp"
            android:textColor="#888888"
            android:id="@+id/tv_pay_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_15dp_sw_320_dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:background="#f8f8f8"
        android:layout_width="match_parent"
        android:layout_height="30dp">
        <View
            android:id="@+id/view_appline"
            android:background="@color/appline"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dark_green"
            android:gravity="center"
            android:id="@+id/tv_pc_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_15dp_sw_320_dp"
            android:text="@string/verification_code"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</LinearLayout>
