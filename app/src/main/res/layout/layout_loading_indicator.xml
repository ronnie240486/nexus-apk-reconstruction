<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_main_layout_loading_indicator"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true">
    <ImageView
        android:id="@+id/iv_progress_layout_loading_indicator"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/player_progress_img"/>
    <TextView
        android:textSize="@dimen/dimen_14sp_sw_320_dp"
        android:textColor="#ffffff"
        android:id="@+id/tv_loading_tip"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dimen_4dp_sw_320_dp"
        android:text="@string/loading_hardly"
        android:layout_toRightOf="@+id/iv_progress_layout_loading_indicator"
        android:layout_centerVertical="true"/>
    <include
        android:id="@+id/layout_loading_indicator"
        android:layout_width="@dimen/dimen_60dp_sw_320_dp"
        android:layout_height="@dimen/dimen_60dp_sw_320_dp"
        android:layout_centerInParent="true"
        layout="@layout/player_buf_pro"/>
</RelativeLayout>
