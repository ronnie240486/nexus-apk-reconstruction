<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dimen_33dp_sw_320_dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/rl_navigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp_sw_320_dp">
        <ImageButton
            android:id="@+id/ib_search"
            android:background="@drawable/selector_btn_main_radio_btn"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_home_search"
            android:minWidth="@dimen/dimen_36dp_sw_320_dp"
            android:minHeight="@dimen/dimen_18dp_sw_320_dp"
            android:contentDescription="@string/search_home"/>
        <android.media.ViviTV.widget.ExtendedHorScrollView
            android:id="@+id/hsv_toolbar_wrapper"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioGroup
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/rg_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </android.media.ViviTV.widget.ExtendedHorScrollView>
    </LinearLayout>
    <android.media.view.NonSwipeableViewPager
        android:layout_gravity="center_horizontal"
        android:id="@+id/vp_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_navigation"/>
    <FrameLayout
        android:id="@+id/fl_new_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_navigation"/>
</RelativeLayout>
