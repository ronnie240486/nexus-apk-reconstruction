<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom|center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/live_error_dialog_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/liveErrorDialog_fontSize"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/live_error_dialog_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/liveErrorDialog_marginBottom"
        android:text="@string/live_error_dialog_txt"/>
</LinearLayout>
