<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_main_layout_live_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/rl_vod_advertise_layout_layout_live_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/vod_advertise_layout"/>
    <FrameLayout
        android:id="@+id/fl_ratio_layout_wrapper"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <net.soulwolf.widget.ratiolayout.widget.RatioFrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/ratio_rl_main"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:heightRatio="9"
            app:widthRatio="16">
            <FrameLayout
                android:id="@+id/fl_video_view_wrapper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </net.soulwolf.widget.ratiolayout.widget.RatioFrameLayout>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/iv_fullscreen"
            android:background="@drawable/drawable_custom_shape"
            android:padding="7dp"
            android:layout_width="@dimen/dimen_32dp_sw_320_dp"
            android:layout_height="@dimen/dimen_32dp_sw_320_dp"
            android:layout_marginRight="@dimen/dimen_5dp_sw_320_dp"
            android:layout_marginBottom="@dimen/dimen_5dp_sw_320_dp"
            android:src="@drawable/video_enlarge"/>
    </FrameLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_6dp_sw_320_dp"
        android:layout_toLeftOf="@+id/iv_left_top_ad_layout_live_player"
        layout="@layout/layout_subtitle_ad"/>
    <ImageView
        android:id="@+id/iv_left_top_ad_layout_live_player"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_36dp_sw_320_dp"
        android:layout_height="@dimen/dimen_36dp_sw_320_dp"
        android:layout_marginRight="@dimen/dimen_6dp_sw_320_dp"
        android:layout_alignParentRight="true"/>
    <View
        android:id="@+id/iv_middle_ad_layout_live_player_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:id="@+id/iv_middle_ad_layout_live_player"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:id="@+id/iv_pre_ad_layout_live_player"
        android:background="#000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="@dimen/vodPlayLayout_info_bigfontSize"
        android:textColor="#ffffff"
        android:id="@+id/tv_tip"
        android:background="@drawable/video_list_length_bg"
        android:padding="@dimen/vodPlayLayout_info_padding"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp_sw_320_dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/fl_channel_wrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/fl_ratio_layout_wrapper"/>
    <FrameLayout
        android:id="@+id/fl_vod_player_fragment_container_layout_activity_video_details"
        android:background="@drawable/selector_bg_vod_player_fragment_container"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <requestFocus/>
    </FrameLayout>
    <include
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        layout="@layout/layout_btn_reload"/>
    <TextView
        android:textSize="@dimen/dimen_12sp_sw_320_dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_tip_in_live_shifting"
        android:background="@drawable/drawable_btn_back_to_live_normal"
        android:paddingLeft="@dimen/dimen_10dp_sw_320_dp"
        android:paddingTop="@dimen/dimen_4dp_sw_320_dp"
        android:paddingRight="@dimen/dimen_10dp_sw_320_dp"
        android:paddingBottom="@dimen/dimen_4dp_sw_320_dp"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_10dp_sw_320_dp"
        android:layout_marginBottom="@dimen/dimen_50dp_sw_320_dp"
        android:minWidth="@dimen/dimen_100dp_sw_320_dp"
        android:text="@string/tip_live_shifting_status"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textSize="@dimen/dimen_14sp_sw_320_dp"
        android:textColor="#ffffff"
        android:id="@+id/tv_log"
        android:background="@drawable/drawable_btn_back_to_live_normal"
        android:paddingLeft="@dimen/dimen_10dp_sw_320_dp"
        android:paddingTop="@dimen/dimen_4dp_sw_320_dp"
        android:paddingRight="@dimen/dimen_10dp_sw_320_dp"
        android:paddingBottom="@dimen/dimen_4dp_sw_320_dp"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_10dp_sw_320_dp"
        android:layout_marginBottom="@dimen/dimen_50dp_sw_320_dp"
        android:minWidth="@dimen/dimen_100dp_sw_320_dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
