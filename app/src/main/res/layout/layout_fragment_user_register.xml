<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="@dimen/settingMain_layout1_paddingLeftRight"
    android:paddingTop="@dimen/dimen_10dp_sw_320_dp"
    android:paddingRight="@dimen/settingMain_layout1_paddingLeftRight"
    android:paddingBottom="@dimen/settingActive_layout0_marginTop"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_user_name_wrapper_layout_fragment_user_register"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/dimen_12sp_sw_320_dp"
            android:id="@+id/tv_user_name_layout_fragment_user_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dimen_80dp_sw_320_dp"
            android:text="@string/user_register_user_name"
            android:lines="1"
            android:singleLine="true"
            android:layout_centerVertical="true"
            style="?attr/styleSettingTextView"/>
        <EditText
            android:textSize="@dimen/dimen_12sp_sw_320_dp"
            android:textColor="#ffffff"
            android:id="@+id/edt_user_name_layout_fragment_user_register"
            android:background="@drawable/selector_edt_default"
            android:nextFocusUp="@+id/edt_user_name_layout_fragment_user_register"
            android:nextFocusDown="@+id/spinner_area_layout_fragment_user_register"
            android:layout_width="@dimen/dimen_264dp_sw_320_dp"
            android:layout_height="@dimen/dimen_24dp_sw_320_dp"
            android:layout_marginLeft="@dimen/dimen_6dp_sw_320_dp"
            android:lines="1"
            android:singleLine="true"
            android:layout_toRightOf="@+id/tv_user_name_layout_fragment_user_register"
            android:layout_centerVertical="true"
            android:inputType="text"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_area_wrapper_layout_fragment_user_register"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp_sw_320_dp"
        android:layout_below="@+id/rl_user_name_wrapper_layout_fragment_user_register">
        <TextView
            android:textSize="@dimen/dimen_12sp_sw_320_dp"
            android:id="@+id/tv_area_layout_fragment_user_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dimen_80dp_sw_320_dp"
            android:text="@string/user_register_area"
            android:lines="1"
            android:singleLine="true"
            android:layout_centerVertical="true"
            style="?attr/styleSettingTextView"/>
        <Spinner
            android:id="@+id/spinner_area_layout_fragment_user_register"
            android:background="@drawable/selector_spinner_area_info"
            android:nextFocusUp="@+id/edt_user_name_layout_fragment_user_register"
            android:nextFocusDown="@+id/edt_address_layout_fragment_user_register"
            android:layout_width="@dimen/dimen_264dp_sw_320_dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_6dp_sw_320_dp"
            android:prompt="@string/prompt_select_area"
            android:layout_toRightOf="@+id/tv_area_layout_fragment_user_register"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_address_wrapper_layout_fragment_user_register"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp_sw_320_dp"
        android:layout_below="@+id/rl_area_wrapper_layout_fragment_user_register">
        <TextView
            android:textSize="@dimen/dimen_12sp_sw_320_dp"
            android:id="@+id/tv_address_layout_fragment_user_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dimen_80dp_sw_320_dp"
            android:text="@string/user_register_address"
            android:lines="1"
            android:singleLine="true"
            android:layout_centerVertical="true"
            style="?attr/styleSettingTextView"/>
        <EditText
            android:textSize="@dimen/dimen_12sp_sw_320_dp"
            android:textColor="#ffffff"
            android:id="@+id/edt_address_layout_fragment_user_register"
            android:background="@drawable/selector_edt_default"
            android:nextFocusUp="@+id/spinner_area_layout_fragment_user_register"
            android:nextFocusDown="@+id/btn_register_layout_fragment_user_register"
            android:layout_width="@dimen/dimen_264dp_sw_320_dp"
            android:layout_height="@dimen/dimen_24dp_sw_320_dp"
            android:layout_marginLeft="@dimen/dimen_6dp_sw_320_dp"
            android:lines="1"
            android:singleLine="true"
            android:layout_toRightOf="@+id/tv_address_layout_fragment_user_register"
            android:layout_centerVertical="true"
            android:inputType="text"/>
    </RelativeLayout>
    <Button
        android:textSize="@dimen/dimen_12sp_sw_320_dp"
        android:id="@+id/btn_register_layout_fragment_user_register"
        android:paddingLeft="@dimen/dimen_30dp_sw_320_dp"
        android:paddingTop="@dimen/dimen_4dp_sw_320_dp"
        android:paddingRight="@dimen/dimen_30dp_sw_320_dp"
        android:paddingBottom="@dimen/dimen_4dp_sw_320_dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp_sw_320_dp"
        android:text="@string/user_register_register"
        android:layout_below="@+id/rl_address_wrapper_layout_fragment_user_register"
        style="?attr/styleSettingButton"/>
</RelativeLayout>
