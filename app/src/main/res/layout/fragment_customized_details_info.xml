<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:RoundedImageView="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_custom"
    android:padding="@dimen/dimen_15dp_sw_320_dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dimen_17dp_sw_320_dp"
        android:textColor="?attr/colorVideoFavEmpty"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_5dp_sw_320_dp"/>
    <ScrollView
        android:id="@+id/sv_bottom"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tv_name">
        <RelativeLayout
            android:id="@+id/rl_introduce_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dimen_5dp_sw_320_dp"
            android:layout_marginRight="@dimen/dimen_5dp_sw_320_dp">
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/ll_introduction_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_10dp_sw_320_dp">
                <com.makeramen.roundedimageview.RoundedImageViewFixWHR
                    android:id="@+id/iv_introduce_detail"
                    android:background="@drawable/img_corner_bg"
                    android:layout_width="@dimen/dimen_80dp_sw_320_dp"
                    android:layout_height="@dimen/dimen_100dp_sw_320_dp"
                    RoundedImageView:riv_corner_radius="@dimen/dimen_6dp_sw_320_dp"/>
                <TextView
                    android:textSize="@dimen/dimen_16dp_sw_320_dp"
                    android:textColor="?attr/colorDarkBlueText"
                    android:id="@+id/tv_details_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_10dp_sw_320_dp"
                    android:layout_toRightOf="@+id/iv_introduce_detail"/>
                <TextView
                    android:textSize="@dimen/dimen_12dp_sw_320_dp"
                    android:textColor="?attr/colorDarkBlueText"
                    android:id="@+id/tv_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_10dp_sw_320_dp"
                    android:layout_marginTop="@dimen/dimen_5dp_sw_320_dp"
                    android:layout_toRightOf="@+id/iv_introduce_detail"
                    android:layout_below="@+id/tv_details_name"/>
                <TextView
                    android:textSize="@dimen/dimen_10dp_sw_320_dp"
                    android:textColor="?attr/colorVideoFavEmpty"
                    android:id="@+id/tv_detailContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_10dp_sw_320_dp"
                    android:layout_marginTop="@dimen/dimen_5dp_sw_320_dp"
                    android:layout_toRightOf="@+id/iv_introduce_detail"
                    android:layout_below="@+id/tv_label"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/dimen_12dp_sw_320_dp"
                android:textColor="?attr/colorDarkBlueText"
                android:id="@+id/tv_detailed_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dimen_10dp_sw_320_dp"
                android:text="@string/detailed_introduction"
                android:layout_below="@+id/ll_introduction_details"/>
            <TextView
                android:textSize="@dimen/dimen_10dp_sw_320_dp"
                android:textColor="?attr/colorVideoFavEmpty"
                android:id="@+id/tv_detailed_introduction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_10dp_sw_320_dp"
                android:layout_below="@+id/tv_detailed_tip"/>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
