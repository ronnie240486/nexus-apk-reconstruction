<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_league_left_menu_item"
    android:paddingLeft="@dimen/dimen_4dp_sw_320_dp"
    android:paddingRight="@dimen/dimen_4dp_sw_320_dp"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_match_schedule_league_logo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/colorLiveChannelWindowListItemPlayingNot"
        android:gravity="center_vertical"
        android:id="@+id/tv_match_schedule_league_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text=""
        android:lines="1"
        android:layout_toRightOf="@+id/iv_match_schedule_league_logo"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"/>
</RelativeLayout>
