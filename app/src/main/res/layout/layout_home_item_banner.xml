        Banner:indicator_drawable_unselected="@drawable/ic_banner_indicator_default"
        Banner:indicator_height="@dimen/dimen_7dp_sw_320_dp"
        Banner:indicator_width="@dimen/dimen_21dp_sw_320_dp"/>
</android.media.ViviTV.widget.ExtendedRelativeLayout>
