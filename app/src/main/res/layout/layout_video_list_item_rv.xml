<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fixedWHRadioImageView="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/selector_home_recycler_item"
    android:paddingLeft="@dimen/dimen_6dp_sw_320_dp"
    android:paddingRight="@dimen/dimen_6dp_sw_320_dp"
    android:focusable="true"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <android.media.view.FixedWHRatioImageView
        android:id="@+id/poster"
        android:layout_width="@dimen/dimen_86dp_sw_320_dp"
        android:layout_height="wrap_content"
        android:src="@drawable/default_film_img"
        android:scaleType="fitXY"
        fixedWHRadioImageView:ratio="0.69"/>
    <ImageView
        android:id="@+id/source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_youtube_source"
        android:scaleType="centerInside"/>
    <TextView
        android:textSize="@dimen/typeDetailsItem_videoName_fontSize"
        android:textColor="@drawable/video_textcolor_selector"
        android:ellipsize="marquee"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_20dp_sw_320_dp"
        android:layout_marginLeft="@dimen/dimen_2dp_sw_320_dp"
        android:singleLine="true"
        android:layout_below="@+id/poster"
        android:layout_alignLeft="@+id/poster"
        android:layout_alignRight="@+id/poster"
        android:marqueeRepeatLimit="marquee_forever"/>
    <TextView
        android:textSize="@dimen/dimen_10sp_sw_320_dp"
        android:textColor="#1e90ff"
        android:id="@+id/grade"
        android:background="@drawable/drawable_bg_black_half_transparent"
        android:paddingLeft="@dimen/dimen_4dp_sw_320_dp"
        android:paddingRight="@dimen/dimen_4dp_sw_320_dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_2dp_sw_320_dp"
        android:layout_marginBottom="@dimen/dimen_2dp_sw_320_dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:id="@+id/vip_mark"
        android:background="@drawable/ic_vip_flag_bg"
        android:visibility="invisible"
        android:layout_width="@dimen/dimen_16dp_sw_320_dp"
        android:layout_height="@dimen/dimen_16dp_sw_320_dp"
        android:layout_marginTop="@dimen/dimen_2dp_sw_320_dp"
        android:layout_marginRight="@dimen/dimen_2dp_sw_320_dp"
        android:layout_alignRight="@+id/poster"/>
</RelativeLayout>
