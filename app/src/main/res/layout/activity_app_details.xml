<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:PageIndicatorView="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ic_bg_tv_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dimen_30dp_sw_320_dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/rl_top_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_31dp_sw_320_dp"
                android:layout_marginTop="@dimen/dimen_28dp_sw_320_dp"
                android:layout_marginRight="@dimen/dimen_34dp_sw_320_dp">
                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="@dimen/dimen_58dp_sw_320_dp"
                    android:layout_height="@dimen/dimen_58dp_sw_320_dp"
                    android:layout_marginRight="@dimen/dimen_12dp_sw_320_dp"
                    android:scaleType="fitXY"
                    PageIndicatorView:riv_corner_radius="@dimen/dimen_4dp_sw_320_dp"/>
                <TextView
                    android:textSize="@dimen/dimen_12dp_sw_320_dp"
                    android:textColor="?attr/colorAppDetailsTitle"
                    android:gravity="center"
                    android:id="@+id/tv_app_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_toLeftOf="@+id/btn_install"
                    android:layout_toRightOf="@+id/iv_logo"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_info_wrapper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_6dp_sw_320_dp"
                    android:layout_toRightOf="@+id/iv_logo"
                    android:layout_below="@+id/tv_app_name">
                    <TextView
                        android:textSize="@dimen/dimen_8dp_sw_320_dp"
                        android:textColor="?attr/colorAppDetailsSummary"
                        android:id="@+id/tv_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <TextView
                        android:textSize="@dimen/dimen_8dp_sw_320_dp"
                        android:textColor="?attr/colorAppDetailsSummary"
                        android:id="@+id/tv_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_6dp_sw_320_dp"
                        android:text=""/>
                    <TextView
                        android:textSize="@dimen/dimen_8dp_sw_320_dp"
                        android:textColor="?attr/colorAppDetailsSummary"
                        android:id="@+id/tv_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_6dp_sw_320_dp"
                        android:text=""/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/dimen_9dp_sw_320_dp"
                    android:textColor="?attr/colorAppDetailsSummary"
                    android:gravity="left"
                    android:id="@+id/tv_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_6dp_sw_320_dp"
                    android:text=""
                    android:layout_toLeftOf="@+id/btn_install"
                    android:layout_toRightOf="@+id/iv_logo"
                    android:layout_below="@+id/ll_info_wrapper"/>
                <Button
                    android:textSize="@dimen/dimen_10sp_sw_320_dp"
                    android:textColor="?attr/colorBtnTextUninstall"
                    android:gravity="center"
                    android:id="@+id/btn_install"
                    android:background="?attr/backgroundBtnUninstall"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dimen_24dp_sw_320_dp"
                    android:layout_marginLeft="@dimen/dimen_60dp_sw_320_dp"
                    android:minWidth="@dimen/dimen_64dp_sw_320_dp"
                    android:text="@string/install"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_pic_wrapper"
                android:background="@drawable/drawable_bg_black_half_transparent"
                android:layout_width="@dimen/dimen_296dp_sw_320_dp"
                android:layout_height="@dimen/dimen_166dp_sw_320_dp"
                android:layout_marginTop="@dimen/dimen_20dp_sw_320_dp"
                android:layout_below="@+id/rl_top_wrapper"
                android:layout_centerHorizontal="true">
                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/vp_pics"
                    android:background="@drawable/selector_white_border"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.p010rd.PageIndicatorView
                    android:id="@+id/page_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimen_4dp_sw_320_dp"
                    android:layout_alignBottom="@+id/vp_pics"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    PageIndicatorView:piv_animationType="none"
                    PageIndicatorView:piv_selectedColor="@color/theme_highlight"
                    PageIndicatorView:piv_unselectedColor="#343441"/>
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
