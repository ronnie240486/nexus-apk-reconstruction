<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_filter_item_v2"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dimen_10sp_sw_320_dp"
        android:textColor="@color/color_filter_v2"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_title"
        android:paddingLeft="@dimen/dimen_4dp_sw_320_dp"
        android:paddingRight="@dimen/dimen_4dp_sw_320_dp"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dimen_46dp_sw_320_dp"
        android:minHeight="@dimen/dimen_18dp_sw_320_dp"/>
</LinearLayout>
