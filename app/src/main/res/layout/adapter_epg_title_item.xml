<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/selector_bg_epg_info_item"
    android:paddingLeft="@dimen/dimen_8dp_sw_320_dp"
    android:paddingTop="@dimen/dimen_8dp_sw_320_dp"
    android:paddingBottom="@dimen/dimen_8dp_sw_320_dp"
    android:focusable="true"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_line_left"
        android:background="#80a8a7a5"
        android:layout_width="@dimen/dimen_30dp_sw_320_dp"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dimen_7dp_sw_320_dp"
        android:layout_marginRight="@dimen/dimen_4dp_sw_320_dp"
        android:layout_toLeftOf="@+id/tv_title"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/dimen_10sp_sw_320_dp"
        android:textColor="?attr/colorLiveChannelWindowProgramItemText"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:focusable="true"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp_sw_320_dp"
        android:layout_centerInParent="true"/>
    <View
        android:id="@+id/view_line_right"
        android:background="#80a8a7a5"
        android:layout_width="@dimen/dimen_30dp_sw_320_dp"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dimen_4dp_sw_320_dp"
        android:layout_marginRight="@dimen/dimen_7dp_sw_320_dp"
        android:layout_toRightOf="@+id/tv_title"
        android:layout_centerVertical="true"/>
</RelativeLayout>
