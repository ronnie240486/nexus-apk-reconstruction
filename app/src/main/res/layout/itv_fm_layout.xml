<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:paddingLeft="@dimen/dimen_15dp_sw_320_dp"
        android:paddingTop="@dimen/dimen_10dp_sw_320_dp"
        android:paddingRight="@dimen/dimen_15dp_sw_320_dp"
        android:paddingBottom="@dimen/dimen_10dp_sw_320_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <CheckBox
            android:id="@+id/cb_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"/>
        <ImageView
            android:id="@+id/iv_fm"
            android:background="@drawable/icon_default_fm"
            android:layout_width="@dimen/dimen_60dp_sw_320_dp"
            android:layout_height="@dimen/dimen_40dp_sw_320_dp"
            android:layout_marginLeft="@dimen/dimen_10dp_sw_320_dp"
            android:layout_toRightOf="@+id/cb_play"
            android:layout_centerInParent="true"/>
        <TextView
            android:textColor="@color/black"
            android:id="@+id/tv_fm_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_10dp_sw_320_dp"
            android:layout_toRightOf="@+id/iv_fm"
            android:layout_centerInParent="true"/>
        <TextView
            android:textColor="@color/black"
            android:id="@+id/tv_play_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_timbre"
            android:background="@drawable/video_details_hd"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_20dp_sw_320_dp"
            android:layout_toLeftOf="@+id/tv_play_type"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_fm_collection"
            android:background="@drawable/icon_collection_no"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_25dp_sw_320_dp"
            android:layout_height="@dimen/dimen_25dp_sw_320_dp"
            android:layout_marginRight="@dimen/dimen_20dp_sw_320_dp"
            android:layout_toLeftOf="@+id/iv_timbre"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
