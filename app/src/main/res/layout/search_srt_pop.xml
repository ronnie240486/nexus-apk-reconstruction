<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="@dimen/searchSrtPop_width"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/searchSrtPop_margin">
        <Button
            android:textSize="@dimen/searchSrtPop_fontSize"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/search_srt_search_content"
            android:background="@drawable/menu_bg_h"
            android:layout_width="@dimen/searchSrtPop_width"
            android:layout_height="@dimen/searchSrtPop_content_height"
            android:singleLine="true"/>
    </LinearLayout>
    <ImageView
        android:background="#b2b2b2"
        android:layout_width="@dimen/searchSrtPop_width"
        android:layout_height="@dimen/searchSrtPop_img_height"
        android:layout_margin="@dimen/searchSrtPop_img_margin"/>
    <ListView
        android:id="@+id/search_srt_search_liseview"
        android:layout_width="@dimen/searchSrtPop_width"
        android:layout_height="@dimen/searchSrtPop_liseview_height"/>
</LinearLayout>
