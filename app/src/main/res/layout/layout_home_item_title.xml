<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimen_38dp_sw_320_dp">
    <ImageView
        android:id="@+id/iv_left_title_layout_home_item_title"
        android:layout_width="@dimen/dimen_36dp_sw_320_dp"
        android:layout_height="@dimen/dimen_36dp_sw_320_dp"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="@dimen/dimen_15dp_sw_320_dp"
        android:textColor="?attr/colorHomeDisplayItemTitle"
        android:id="@+id/tv_title_layout_home_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_4dp_sw_320_dp"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/iv_left_title_layout_home_item_title"/>
</RelativeLayout>
