<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_main_title_bar_common"
    style="?attr/styleTitleBarContainer">
    <Button
        android:id="@+id/btn_back_layout_title_bar_common"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?attr/styleTitleBarLeftButton"/>
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?attr/styleTitleBarCenterTitle"/>
    <View
        android:id="@+id/app_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp_sw_320_dp"
        style="?attr/styleTitleBarBottomDivider"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_title_bar_right_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_8dp_sw_320_dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
