<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_search_edt_wrapper"
        android:paddingLeft="@dimen/dimen_12dp_sw_320_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dimen_60dp_sw_320_dp">
        <EditText
            android:textSize="@dimen/dimen_14sp_sw_320_dp"
            android:textColor="#898991"
            android:textColorHint="#989898"
            android:id="@+id/edt_keyword"
            android:background="@drawable/selector_edt_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:hint="@string/hint_keyword"
            android:singleLine="true"
            android:drawableLeft="@drawable/ic_search_edt_left_icon"
            android:drawablePadding="@dimen/dimen_6dp_sw_320_dp"
            android:layout_toLeftOf="@+id/btn_search"
            android:layout_centerVertical="true"
            android:inputType="text"
            android:imeOptions="actionNext"/>
        <Button
            android:textSize="@dimen/dimen_14sp_sw_320_dp"
            android:textColor="#898991"
            android:id="@+id/btn_search"
            android:background="@android:color/transparent"
            android:paddingLeft="@dimen/dimen_12dp_sw_320_dp"
            android:paddingRight="@dimen/dimen_18dp_sw_320_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_6dp_sw_320_dp"
            android:minWidth="@dimen/dimen_40dp_sw_320_dp"
            android:minHeight="@dimen/dimen_32dp_sw_320_dp"
            android:text="@string/search"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/view_divider"
        android:background="#f6f6f6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp_sw_320_dp"
        android:layout_below="@+id/rl_search_edt_wrapper"/>
    <RelativeLayout
        android:id="@+id/rl_search_history_wrapper"
        android:paddingLeft="@dimen/dimen_12dp_sw_320_dp"
        android:paddingRight="@dimen/dimen_10dp_sw_320_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_divider">
        <TextView
            android:textSize="16sp"
            android:textColor="#2a2a2a"
            android:gravity="center_vertical"
            android:id="@+id/tv_lbl_search_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_history"
            android:layout_alignTop="@+id/ib_clear_search_history"
            android:layout_alignBottom="@+id/ib_clear_search_history"/>
        <ImageButton
            android:id="@+id/ib_clear_search_history"
            android:background="@android:color/transparent"
            android:padding="@dimen/dimen_10dp_sw_320_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_clear_history_search"
            android:layout_alignParentRight="true"/>
        <RelativeLayout
            android:id="@+id/rl_words_tip_wrapper"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_80dp_sw_320_dp"
            android:layout_below="@+id/ib_clear_search_history">
            <TextView
                android:textSize="@dimen/dimen_12sp_sw_320_dp"
                android:textColor="#cdcdcd"
                android:id="@+id/tv_has_no_search_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/has_not_search_history"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <android.media.view.FlowLayout
                android:id="@+id/flow_layout_search_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
    </RelativeLayout>
    <GridView
        android:id="@+id/gv_search_result"
        android:paddingLeft="@dimen/dimen_14dp_sw_320_dp"
        android:paddingRight="@dimen/searchNew_gridResult_marginRight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:horizontalSpacing="@dimen/dimen_10dp_sw_320_dp"
        android:verticalSpacing="@dimen/dimen_6dp_sw_320_dp"
        android:numColumns="4"
        android:layout_below="@+id/view_divider"/>
</RelativeLayout>
