<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/selector_bg_epg_info_item"
    android:paddingLeft="@dimen/dimen_10dp_sw_320_dp"
    android:paddingTop="@dimen/dimen_8dp_sw_320_dp"
    android:paddingBottom="@dimen/dimen_8dp_sw_320_dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_9dp_sw_320_dp"
        android:textColor="?attr/colorLiveChannelWindowProgramItemText"
        android:id="@+id/tv_epg_start_time"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:00"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/dimen_10sp_sw_320_dp"
        android:textColor="?attr/colorLiveChannelWindowProgramItemText"
        android:ellipsize="end"
        android:id="@+id/tv_program_name"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_2dp_sw_320_dp"
        android:layout_toRightOf="@+id/tv_epg_start_time"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/iv_review_play"
        android:layout_width="@dimen/dimen_10dp_sw_320_dp"
        android:layout_height="@dimen/dimen_10dp_sw_320_dp"
        android:layout_marginRight="@dimen/dimen_14dp_sw_320_dp"
        android:src="@drawable/icon_review_play"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
