<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fixedWHRadioImageView="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_item"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fl_main_layout_type_details_item"
        android:background="@drawable/selector_bg_video_item_search_result"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <android.media.view.FixedWHRatioImageView
                android:id="@+id/video_poster"
                android:background="#00666666"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/default_film_img"
                android:scaleType="fitXY"
                fixedWHRadioImageView:ratio="0.74"/>
            <ImageView
                android:id="@+id/iv_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_youtube_source"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="@dimen/dimen_8sp_sw_320_dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/vip_mark_layout_type_details_item"
                android:background="#fb600b"
                android:paddingLeft="@dimen/dimen_2dp_sw_320_dp"
                android:paddingRight="@dimen/dimen_2dp_sw_320_dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIP"
                android:layout_alignParentRight="true"
                android:alpha="0.8"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/video_superHD"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/hd"/>
        <ImageView
            android:id="@+id/video_gou"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/sele_item_log"/>
        <TextView
            android:textSize="@dimen/typeDetailsItem_videoBanBen_fontSize"
            android:textColor="@color/detail_point"
            android:ellipsize="marquee"
            android:gravity="center_horizontal"
            android:layout_gravity="bottom"
            android:id="@+id/video_banben"
            android:background="@drawable/video_textbg_selector"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/typeDetailsItem_videoBanBen_height"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <TextView
            android:textSize="@dimen/dimen_10sp_sw_320_dp"
            android:textColor="@drawable/video_textcolor_selector"
            android:ellipsize="marquee"
            android:gravity="center_horizontal"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/video_name"
            android:background="@drawable/drawable_bg_video_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
    </FrameLayout>
</RelativeLayout>
