<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/drawable_epg_one_channel_type"
    android:paddingTop="@dimen/dimen_8dp_sw_320_dp"
    android:paddingBottom="@dimen/dimen_8dp_sw_320_dp"
    android:layout_width="@dimen/dimen_196dp_sw_320_dp"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dimen_18sp_sw_320_dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_channel_type_name_layout_epg_one_channel_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="channel type"/>
    <ListView
        android:id="@+id/lv_channel_list_layout_epg_one_channel_type"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_8dp_sw_320_dp"
        android:listSelector="@drawable/selector_epg_default"
        android:divider="@drawable/drawable_transparent"
        android:layout_below="@+id/tv_channel_type_name_layout_epg_one_channel_type"/>
</RelativeLayout>
