<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.lucasr.twowayview.widget.TwoWayView
        android:id="@+id/main_two_way_view_home_item_fragment"
        android:paddingLeft="@dimen/dimen_30dp_sw_320_dp"
        android:paddingTop="@dimen/dimen_10dp_sw_320_dp"
        android:paddingRight="@dimen/dimen_30dp_sw_320_dp"
        android:paddingBottom="@dimen/dimen_10dp_sw_320_dp"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/title_group"
        app:twowayview_layoutManager="SpannableGridLayoutManager"
        app:twowayview_numColumns="120"
        app:twowayview_numRows="60"
        style="@style/TwoWayView"/>
    <com.omadahealth.github.swipyrefreshlayout.library.SwipyRefreshLayout
        android:id="@+id/swipy_refresh_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srl_direction="both">
        <ListView
            android:id="@+id/lv_list"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/divider_gray"
            android:dividerHeight="@dimen/dimen_1dp_sw_320_dp"/>
    </com.omadahealth.github.swipyrefreshlayout.library.SwipyRefreshLayout>
</LinearLayout>
