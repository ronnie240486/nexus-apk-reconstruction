<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/selector_tag_button"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/dimen_23dp_sw_320_dp">
    <ImageButton
        android:id="@+id/ib_key"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/dimen_1dp_sw_320_dp"
        android:minHeight="@dimen/dimen_22dp_sw_320_dp"/>
    <Button
        android:textSize="@dimen/dimen_8dp_sw_320_dp"
        android:textColor="@color/white"
        android:id="@+id/btn_key"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/dimen_1dp_sw_320_dp"
        android:minHeight="@dimen/dimen_22dp_sw_320_dp"/>
</RelativeLayout>
