<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/backgroundVideoDetailsVideoSetItem"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/tv_set_name_layout_video_episode_item_bg"
        android:layout_width="@dimen/dimen_112dp_sw_320_dp"
        android:layout_height="@dimen/dimen_47dp_sw_320_dp"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="@dimen/dimen_10sp_sw_320_dp"
        android:textColor="?attr/colorVideoDetailsVideoSetName"
        android:gravity="center"
        android:id="@+id/tv_set_name_layout_video_episode_item_small"
        android:layout_width="@dimen/dimen_47dp_sw_320_dp"
        android:layout_height="@dimen/dimen_24dp_sw_320_dp"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="@dimen/dimen_10sp_sw_320_dp"
        android:textColor="?attr/colorVideoDetailsVideoSetName"
        android:ellipsize="end"
        android:id="@+id/tv_set_name_layout_video_episode_item_big"
        android:layout_width="@dimen/dimen_91dp_sw_320_dp"
        android:layout_height="@dimen/dimen_30dp_sw_320_dp"
        android:maxLines="2"
        android:layout_centerInParent="true"/>
</RelativeLayout>
