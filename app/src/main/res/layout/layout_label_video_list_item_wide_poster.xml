<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/selector_label_video_item"
    android:focusable="true"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/poster"
        android:duplicateParentState="true"
        android:layout_width="@dimen/dimen_120dp_sw_320_dp"
        android:layout_height="@dimen/dimen_72dp_sw_320_dp"
        android:src="@drawable/ic_banner_default"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_youtube_source"
        android:scaleType="centerInside"/>
    <TextView
        android:textSize="@dimen/dimen_4dp_sw_320_dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/vip_mark"
        android:background="#fb600b"
        android:padding="@dimen/dimen_2dp_sw_320_dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_2dp_sw_320_dp"
        android:layout_marginRight="@dimen/dimen_2dp_sw_320_dp"
        android:text="VIP"
        android:layout_alignTop="@+id/poster"
        android:layout_alignRight="@+id/poster"/>
    <TextView
        android:textSize="@dimen/dimen_10sp_sw_320_dp"
        android:textColor="#6d6f80"
        android:ellipsize="marquee"
        android:gravity="center_horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/title"
        android:background="@drawable/drawable_bg_video_name_v2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_6dp_sw_320_dp"
        android:singleLine="true"
        android:layout_alignLeft="@+id/poster"
        android:layout_alignRight="@+id/poster"
        android:layout_alignBottom="@+id/poster"
        android:marqueeRepeatLimit="marquee_forever"/>
    <TextView
        android:textSize="@dimen/dimen_10sp_sw_320_dp"
        android:textColor="#1e90ff"
        android:id="@+id/grade"
        android:background="@drawable/drawable_bg_black_half_transparent"
        android:paddingLeft="@dimen/dimen_4dp_sw_320_dp"
        android:paddingRight="@dimen/dimen_4dp_sw_320_dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_2dp_sw_320_dp"
        android:layout_marginBottom="@dimen/dimen_2dp_sw_320_dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
