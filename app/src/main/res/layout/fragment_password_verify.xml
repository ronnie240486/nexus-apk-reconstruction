<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/backgroundCustomDialog"
    android:paddingLeft="@dimen/dimen_22dp_sw_320_dp"
    android:paddingTop="@dimen/dimen_16dp_sw_320_dp"
    android:paddingRight="@dimen/dimen_22dp_sw_320_dp"
    android:paddingBottom="@dimen/dimen_16dp_sw_320_dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:enabled="false"
        android:textSize="@dimen/dimen_8dp_sw_320_dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/edt_password"
        android:background="@drawable/selector_edt_pwd_verify"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_26dp_sw_320_dp"
        android:hint="@string/hint_password"
        android:lines="1"
        android:singleLine="true"
        android:inputType="numberPassword"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_keys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_10dp_sw_320_dp"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp_sw_320_dp">
        <Button
            android:textSize="@dimen/dimen_10dp_sw_320_dp"
            android:id="@+id/btn_return_or_change_pwd"
            android:nextFocusLeft="@+id/btn_return_or_change_pwd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dimen_24dp_sw_320_dp"
            android:text="@string/change_password"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/style_button_setting_fragment"/>
        <Button
            android:textSize="@dimen/dimen_10dp_sw_320_dp"
            android:id="@+id/btn_close"
            android:nextFocusRight="@+id/btn_close"
            android:nextFocusUp="@+id/edt_auth_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_10dp_sw_320_dp"
            android:minHeight="@dimen/dimen_24dp_sw_320_dp"
            android:text="@string/close_dialog"
            android:layout_weight="1"
            style="@style/style_button_setting_fragment"/>
    </LinearLayout>
</LinearLayout>
