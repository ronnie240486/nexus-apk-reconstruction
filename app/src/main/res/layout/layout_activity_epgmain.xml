<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/ic_bg_tv_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dimen_18sp_sw_320_dp"
        android:textColor="#ffffff"
        android:id="@+id/tv_title_layout_activity_epgmain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_30dp_sw_320_dp"
        android:layout_marginTop="@dimen/dimen_20dp_sw_320_dp"
        android:text="@string/television_playback"/>
    <HorizontalScrollView
        android:id="@+id/hsv_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dimen_30dp_sw_320_dp"
        android:layout_marginTop="@dimen/dimen_10dp_sw_320_dp"
        android:layout_marginRight="@dimen/dimen_30dp_sw_320_dp"
        android:layout_marginBottom="@dimen/dimen_10dp_sw_320_dp"
        android:layout_below="@+id/tv_title_layout_activity_epgmain"/>
    <TextView
        android:textSize="@dimen/dimen_14sp_sw_320_dp"
        android:textColor="#ffffff"
        android:id="@+id/tv_tip_no_epg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/have_no_epg_info"
        android:layout_centerInParent="true"/>
</RelativeLayout>
