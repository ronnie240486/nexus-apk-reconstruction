<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fwhrl="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_main"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.media.view.FixWHRatioRelativeLayout
        android:id="@+id/rl_vod_container_refer"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        fwhrl:rlRatio="1.65"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_vod_container_refer"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dimen_18sp_sw_320_dp"
                android:textColor="@color/black"
                android:id="@+id/tv_video_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="@dimen/dimen_8dp_sw_320_dp"
                android:paddingBottom="@dimen/dimen_4dp_sw_320_dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dimen_12dp_sw_320_dp"
                    android:textColor="@color/gray"
                    android:id="@+id/tv_video_details_set_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dimen_8dp_sw_320_dp"/>
                <TextView
                    android:textSize="@dimen/dimen_12sp_sw_320_dp"
                    android:textColor="@color/gray"
                    android:id="@+id/tv_video_details_mark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dimen_8dp_sw_320_dp"/>
                <TextView
                    android:textSize="@dimen/dimen_12sp_sw_320_dp"
                    android:textStyle="italic"
                    android:textColor="#43160c"
                    android:id="@+id/tv_video_details_vip_tip"
                    android:paddingLeft="@dimen/dimen_6dp_sw_320_dp"
                    android:paddingTop="@dimen/dimen_1dp_sw_320_dp"
                    android:paddingRight="@dimen/dimen_6dp_sw_320_dp"
                    android:paddingBottom="@dimen/dimen_1dp_sw_320_dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIP"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:paddingTop="@dimen/dimen_8dp_sw_320_dp"
                android:paddingBottom="@dimen/dimen_4dp_sw_320_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dimen_14sp_sw_320_dp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_video_details_director"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dimen_4dp_sw_320_dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp_sw_320_dp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_video_details_year"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:paddingTop="@dimen/dimen_4dp_sw_320_dp"
                android:paddingBottom="@dimen/dimen_4dp_sw_320_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dimen_14sp_sw_320_dp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_video_details_cate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dimen_4dp_sw_320_dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp_sw_320_dp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_video_details_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:paddingTop="@dimen/dimen_4dp_sw_320_dp"
                android:paddingBottom="@dimen/dimen_4dp_sw_320_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dimen_14sp_sw_320_dp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_video_details_actor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="@dimen/dimen_4dp_sw_320_dp"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dimen_14sp_sw_320_dp"
                android:textColor="@color/gray"
                android:ellipsize="end"
                android:id="@+id/tv_video_abstract"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_10dp_sw_320_dp"
                android:maxLines="5"
                android:lineSpacingExtra="@dimen/dimen_2dp_sw_320_dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_video_episode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/layout_line"/>
                <TextView
                    android:textSize="@dimen/dimen_16sp_sw_320_dp"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_10dp_sw_320_dp"
                    android:layout_marginBottom="@dimen/dimen_5dp_sw_320_dp"
                    android:text="@string/details_choice"/>
                <android.media.ViviTV.widget.HorizontalRecyclerView
                    android:id="@+id/hrv_video_episode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimen_10dp_sw_320_dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_relevant_stars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dimen_16sp_sw_320_dp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/relevant_stars"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_relevant_star"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_centerVertical="true"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_recommended"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/layout_line"/>
                <TextView
                    android:textSize="@dimen/dimen_16sp_sw_320_dp"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_10dp_sw_320_dp"
                    android:layout_marginBottom="@dimen/dimen_5dp_sw_320_dp"
                    android:text="@string/details_recommend"/>
                <android.media.ViviTV.widget.GridViewForScrollView
                    android:id="@+id/gv_recommended"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:listSelector="#00000000"
                    android:horizontalSpacing="5dp"
                    android:verticalSpacing="8dp"
                    android:numColumns="3"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/fl_vod_container"
        android:background="@drawable/selector_bg_vod_player_fragment_container"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</RelativeLayout>
