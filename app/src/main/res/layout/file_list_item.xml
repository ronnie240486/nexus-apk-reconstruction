<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/selector_bg_file_list_item"
    android:padding="@dimen/dimen_10dp_sw_320_dp"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_type"
        android:layout_width="@dimen/dimen_32dp_sw_320_dp"
        android:layout_height="@dimen/dimen_32dp_sw_320_dp"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/dimen_13dp_sw_320_dp"
        android:paddingRight="@dimen/dimen_13dp_sw_320_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_40dp_sw_320_dp"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/iv_type">
        <TextView
            android:textSize="@dimen/dimen_12sp_sw_320_dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/dimen_8dp_sw_320_dp"
            android:textColor="@color/gray"
            android:id="@+id/tv_modify_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp_sw_320_dp"/>
    </LinearLayout>
</RelativeLayout>
