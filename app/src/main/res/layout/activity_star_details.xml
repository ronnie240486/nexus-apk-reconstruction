<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_main"
    android:background="@drawable/ic_bg_tv_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dimen_14dp_sw_320_dp"
        android:textStyle="bold"
        android:textColor="@color/detail_main_text"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_32dp_sw_320_dp"
        android:layout_marginTop="@dimen/dimen_32dp_sw_320_dp"
        android:singleLine="true"
        android:maxLength="30"/>
    <TextView
        android:textSize="@dimen/dimen_8dp_sw_320_dp"
        android:textColor="@color/detail_main_text"
        android:id="@+id/tv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp_sw_320_dp"
        android:maxLength="30"
        android:layout_below="@+id/tv_name"
        android:layout_alignLeft="@+id/tv_name"/>
    <TextView
        android:textSize="@dimen/dimen_8dp_sw_320_dp"
        android:textColor="@color/detail_main_text"
        android:ellipsize="end"
        android:id="@+id/tv_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_10dp_sw_320_dp"
        android:layout_marginRight="@dimen/dimen_32dp_sw_320_dp"
        android:maxLines="7"
        android:layout_above="@+id/hrv_videos"
        android:layout_below="@+id/tv_label"
        android:layout_alignLeft="@+id/tv_name"
        android:lineSpacingExtra="@dimen/dimen_2dp_sw_320_dp"/>
    <android.media.ViviTV.widget.HorizontalRecyclerView
        android:id="@+id/hrv_videos"
        android:paddingLeft="@dimen/dimen_32dp_sw_320_dp"
        android:paddingTop="@dimen/dimen_20dp_sw_320_dp"
        android:paddingRight="@dimen/dimen_32dp_sw_320_dp"
        android:paddingBottom="@dimen/dimen_20dp_sw_320_dp"
        android:focusable="true"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_162dp_sw_320_dp"
        android:layout_alignParentBottom="true"
        style="@style/TwoWayView"/>
</RelativeLayout>
